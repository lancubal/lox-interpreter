// Test Mixins in Lox (class ClassName < SuperClass with Mixin1, Mixin2)
class Printable {
  printSelf() {
    print "Printing: " + this.toString();
  }

  class info() {
    print "Printable mixin static method";
  }
}

class Loggable {
  log(msg) {
    print "[LOG] " + msg;
  }
}

class Person with Printable, Loggable {
  init(name) {
    this.name = name;
  }

  toString() {
    return "Person(" + this.name + ")";
  }
}

var p = Person("Luna");
p.printSelf();     // Expected: Printing: Person(Luna)
p.log("Hello!");   // Expected: [LOG] Hello!
Person.info();     // Expected: Printable mixin static method
